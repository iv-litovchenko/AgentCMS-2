<section class="rounded-lg border border-zinc-200 bg-white shadow-sm" aria-labelledby="demo-block-heading">
    <div class="border-b border-zinc-100 px-4 py-3">
        <h2 id="demo-block-heading" class="text-sm font-semibold text-zinc-900">{{ demo_block.title }}</h2>
    </div>
    <ul class="divide-y divide-zinc-100">
        {% for item in demo_block.items %}
            <li class="px-4 py-3 text-sm">
                <p class="font-medium text-zinc-900">{{ item.label }}</p>
                <p class="mt-0.5 text-xs text-zinc-500">{{ item.detail }}</p>
            </li>
        {% endfor %}
    </ul>
</section>
