        {# 1 Typography #}
        <section id="typography" class="{{ is_compact ? 'mb-8' : 'mb-16' }} scroll-mt-20">
            <h2 class="mb-2 {{ is_compact ? 'text-lg' : 'text-xl' }} font-semibold text-zinc-900">1) Typography</h2>
            <div class="space-y-2 rounded-lg border border-zinc-200 bg-white {{ is_compact ? 'p-3' : 'p-6' }} shadow-sm">
                <h1 class="text-4xl font-bold">Heading 1</h1>
                <h2 class="text-3xl font-semibold">Heading 2</h2>
                <h3 class="text-2xl font-semibold">Heading 3</h3>
                <h4 class="text-xl font-medium">Heading 4</h4>
                <h5 class="text-lg font-medium">Heading 5</h5>
                <h6 class="text-base font-medium">Heading 6</h6>
                <p class="text-zinc-700">Paragraph with <strong class="font-semibold">bold</strong>, <em class="italic">italic</em>, and <span class="underline">underline</span>.</p>
                <p class="text-xs text-zinc-500">Small helper text</p>
                <blockquote class="border-l-4 border-blue-500 pl-4 italic text-zinc-600">Blockquote — disk-first workspace, YAML types.</blockquote>
                <p>Inline <code class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-sm text-pink-600">code</code> snippet.</p>
                <pre class="overflow-x-auto rounded-lg bg-zinc-900 p-4 text-sm text-zinc-100"><code>pre block
$cms = 'Agent CMS Light';</code></pre>
            </div>
        </section>

        {# 2 Buttons #}
        <section id="buttons" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">2) Buttons</h2>
            <div class="space-y-6 rounded-lg border border-zinc-200 bg-white p-6 shadow-sm">
                <div class="flex flex-wrap gap-2">
                    <button type="button" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">Primary</button>
                    <button type="button" class="rounded-lg bg-zinc-800 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-900">Secondary</button>
                    <button type="button" class="rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50">Outline</button>
                    <button type="button" class="rounded-lg px-4 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-100">Ghost</button>
                    <button type="button" class="text-sm font-medium text-blue-600 hover:underline">Link</button>
                    <button type="button" disabled class="cursor-not-allowed rounded-lg bg-zinc-200 px-4 py-2 text-sm text-zinc-500">Disabled</button>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" class="rounded-lg bg-blue-600 px-2 py-1 text-xs text-white">xs</button>
                    <button type="button" class="rounded-lg bg-blue-600 px-3 py-1.5 text-sm text-white">sm</button>
                    <button type="button" class="rounded-lg bg-blue-600 px-4 py-2 text-sm text-white">md</button>
                    <button type="button" class="rounded-lg bg-blue-600 px-5 py-2.5 text-base text-white">lg</button>
                    <button type="button" class="rounded-lg bg-blue-600 px-6 py-3 text-lg text-white">xl</button>
                    <button type="button" class="rounded-full bg-blue-600 px-5 py-2 text-sm text-white">Rounded full</button>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm text-white">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        With icon
                    </button>
                </div>
                <div class="inline-flex rounded-lg shadow-sm" role="group">
                    <button type="button" class="rounded-s-lg border border-zinc-300 bg-white px-4 py-2 text-sm hover:bg-zinc-50">Left</button>
                    <button type="button" class="border-y border-zinc-300 bg-white px-4 py-2 text-sm hover:bg-zinc-50">Middle</button>
                    <button type="button" class="rounded-e-lg border border-zinc-300 bg-white px-4 py-2 text-sm hover:bg-zinc-50">Right</button>
                </div>
            </div>
        </section>

        {# 3 Forms #}
        <section id="forms" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">3) Forms</h2>
            <div class="grid gap-6 rounded-lg border border-zinc-200 bg-white p-6 shadow-sm lg:grid-cols-2">
                <label class="block text-sm"><span class="mb-1 block font-medium">Text</span><input type="text" class="w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" placeholder="Name"></label>
                <label class="block text-sm"><span class="mb-1 block font-medium">Email</span><input type="email" class="w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" placeholder="you@example.com"></label>
                <label class="block text-sm"><span class="mb-1 block font-medium">Password</span><input type="password" class="w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm"></label>
                <label class="block text-sm"><span class="mb-1 block font-medium">Number</span><input type="number" class="w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" value="42"></label>
                <label class="block text-sm lg:col-span-2"><span class="mb-1 block font-medium">Search</span><input type="search" class="w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" placeholder="Search workspace…"></label>
                <label class="block text-sm lg:col-span-2"><span class="mb-1 block font-medium">Textarea</span><textarea rows="3" class="w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm"></textarea></label>
                <label class="block text-sm"><span class="mb-1 block font-medium">Select</span><select class="w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm"><option>One</option><option>Two</option></select></label>
                <label class="block text-sm"><span class="mb-1 block font-medium">Multiselect</span><select multiple class="h-24 w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm"><option>YAML</option><option>Twig</option><option>Redis</option></select></label>
                <div class="space-y-2 text-sm"><p class="font-medium">Checkbox / Radio</p>
                    <label class="flex items-center gap-2"><input type="checkbox" class="rounded border-zinc-300 text-blue-600"> Option A</label>
                    <label class="flex items-center gap-2"><input type="radio" name="demo_radio" class="text-blue-600"> Radio 1</label>
                    <label class="flex items-center gap-2"><input type="radio" name="demo_radio" class="text-blue-600"> Radio 2</label>
                </div>
                <div class="text-sm"><p class="mb-2 font-medium">Toggle</p>
                    <label class="inline-flex cursor-pointer items-center">
                        <input type="checkbox" class="peer sr-only">
                        <span class="relative h-6 w-11 rounded-full bg-zinc-200 after:absolute after:start-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-zinc-300 after:bg-white after:transition-all peer-checked:bg-blue-600 peer-checked:after:translate-x-full peer-focus:ring-2 peer-focus:ring-blue-300"></span>
                        <span class="ms-2 text-zinc-600">Switch</span>
                    </label>
                </div>
                <label class="block text-sm lg:col-span-2"><span class="mb-1 block font-medium">Range</span><input type="range" class="w-full accent-blue-600"></label>
                <label class="block text-sm lg:col-span-2"><span class="mb-1 block font-medium">File</span><input type="file" class="block w-full text-sm text-zinc-600 file:mr-4 file:rounded-lg file:border-0 file:bg-blue-50 file:px-4 file:py-2 file:text-sm file:text-blue-700"></label>
                <label class="block text-sm"><span class="mb-1 block font-medium">Date</span><input type="date" class="w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm"></label>
                <label class="block text-sm"><span class="mb-1 block font-medium">Input group</span>
                    <div class="flex"><span class="inline-flex items-center rounded-s-lg border border-e-0 border-zinc-300 bg-zinc-50 px-3 text-zinc-500">@</span><input type="text" class="w-full rounded-e-lg border border-zinc-300 px-3 py-2 text-sm"></div>
                </label>
                <label class="block text-sm"><span class="mb-1 block font-medium text-red-700">Error state</span><input type="text" class="w-full rounded-lg border border-red-500 bg-red-50 px-3 py-2 text-sm text-red-900"><span class="mt-1 text-xs text-red-600">Required field</span></label>
                <label class="block text-sm"><span class="mb-1 block font-medium text-green-700">Success state</span><input type="text" value="OK" class="w-full rounded-lg border border-green-500 bg-green-50 px-3 py-2 text-sm text-green-900"></label>
            </div>
        </section>

        {# 4 Cards #}
        <section id="cards" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">4) Cards</h2>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <div class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm"><h3 class="font-semibold">Basic card</h3><p class="mt-1 text-sm text-zinc-600">Simple content block.</p></div>
                <div class="overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm">
                    <div class="h-24 bg-gradient-to-r from-blue-400 to-indigo-500"></div>
                    <div class="p-4"><h3 class="font-semibold">With image</h3><p class="text-sm text-zinc-600">Header media area.</p></div>
                </div>
                <div class="rounded-lg border border-zinc-200 bg-white shadow-sm">
                    <div class="border-b border-zinc-100 px-4 py-2 text-sm font-medium">Header</div>
                    <div class="p-4 text-sm text-zinc-600">Body</div>
                    <div class="border-t border-zinc-100 px-4 py-2 text-xs text-zinc-500">Footer</div>
                </div>
                <div class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm text-center">
                    <p class="text-xs uppercase text-zinc-500">Pro</p>
                    <p class="text-3xl font-bold">$19</p>
                    <ul class="mt-2 space-y-1 text-sm text-zinc-600"><li>Workspaces</li><li>MCP</li></ul>
                    <button type="button" class="mt-3 w-full rounded-lg bg-blue-600 py-2 text-sm text-white">Buy</button>
                </div>
            </div>
            <blockquote class="mt-4 rounded-lg border border-zinc-200 bg-white p-4 shadow-sm text-sm italic text-zinc-700">“Testimonial card — modular admin cubes.” <span class="mt-2 block not-italic text-xs text-zinc-500">— Demo user</span></blockquote>
        </section>

        {# 5 Alerts #}
        <section id="alerts" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">5) Alerts</h2>
            <div class="space-y-3">
                <div class="rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-800">Success alert</div>
                <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">Error alert</div>
                <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">Warning alert</div>
                <div class="rounded-lg border border-blue-200 bg-blue-50 p-4 text-sm text-blue-800">Info alert</div>
                <div class="flex items-start justify-between rounded-lg border border-zinc-200 bg-white p-4 text-sm shadow-sm">
                    <span>Dismissible (static close button)</span>
                    <button type="button" class="text-zinc-400 hover:text-zinc-600" aria-label="Close">&times;</button>
                </div>
            </div>
        </section>

        {# 6 Badges #}
        <section id="badges" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">6) Badges & tags</h2>
            <div class="flex flex-wrap gap-2">
                <span class="rounded bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-800">Blue</span>
                <span class="rounded bg-green-100 px-2.5 py-1 text-sm text-green-800">Green</span>
                <span class="rounded-full bg-zinc-100 px-3 py-1 text-xs text-zinc-700">Pill</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-zinc-200 ps-2.5 pe-1 py-0.5 text-xs">Tag <button type="button" class="rounded-full hover:bg-zinc-300 px-1">&times;</button></span>
            </div>
        </section>

        {# 7 Avatars #}
        <section id="avatars" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">7) Avatars</h2>
            <div class="flex flex-wrap items-end gap-4">
                <span class="relative inline-flex h-8 w-8 items-center justify-center rounded-full bg-zinc-300 text-xs font-medium">SM</span>
                <span class="relative inline-flex h-12 w-12 items-center justify-center rounded-full bg-blue-600 text-sm font-medium text-white">MD</span>
                <span class="relative inline-flex h-16 w-16 items-center justify-center rounded-lg bg-zinc-800 text-lg text-white">LG</span>
                <span class="relative inline-flex h-12 w-12 items-center justify-center rounded-full bg-emerald-600 text-white">ON<span class="absolute bottom-0 end-0 h-3 w-3 rounded-full border-2 border-white bg-green-500"></span></span>
                <div class="flex -space-x-2">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-zinc-400 text-xs text-white">A</span>
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-zinc-500 text-xs text-white">B</span>
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-zinc-600 text-xs text-white">C</span>
                </div>
            </div>
        </section>

        {# 8 Tables #}
        <section id="tables" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">8) Tables</h2>
            <div class="overflow-x-auto rounded-lg border border-zinc-200 bg-white shadow-sm">
                <table class="min-w-full text-left text-sm">
                    <thead class="bg-zinc-50 text-xs uppercase text-zinc-500"><tr><th class="px-4 py-3">Name</th><th class="px-4 py-3">Type</th><th class="px-4 py-3">Status</th></tr></thead>
                    <tbody class="divide-y divide-zinc-100">
                        <tr class="bg-white hover:bg-zinc-50"><td class="border px-4 py-2">main</td><td class="border px-4 py-2">workspace</td><td class="border px-4 py-2">active</td></tr>
                        <tr class="bg-zinc-50 hover:bg-zinc-100"><td class="border px-4 py-2">sandbox</td><td class="border px-4 py-2">workspace</td><td class="border px-4 py-2">active</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        {# 9 Navigation #}
        <section id="navigation" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">9) Navigation</h2>
            <div class="space-y-6 rounded-lg border border-zinc-200 bg-white p-6 shadow-sm">
                <div class="border-b border-zinc-200"><nav class="flex gap-4 text-sm"><a href="#" class="border-b-2 border-blue-600 pb-2 font-medium text-blue-600">Tab active</a><a href="#" class="pb-2 text-zinc-500 hover:text-zinc-800">Tab</a><a href="#" class="pb-2 text-zinc-500">Tab</a></nav></div>
                <div class="flex gap-2"><a href="#" class="rounded-full bg-blue-600 px-3 py-1 text-sm text-white">Pill active</a><a href="#" class="rounded-full bg-zinc-100 px-3 py-1 text-sm text-zinc-700">Pill</a></div>
                <nav class="text-sm text-zinc-500"><a href="#" class="hover:text-blue-600">Home</a> / <a href="#" class="hover:text-blue-600">CMS</a> / <span class="text-zinc-800">Tailwind</span></nav>
                <nav class="flex gap-1 text-sm" aria-label="Pagination">
                    <a href="#" class="rounded-lg border border-zinc-300 px-3 py-1.5 hover:bg-zinc-50">Prev</a>
                    <a href="#" class="rounded-lg bg-blue-600 px-3 py-1.5 text-white">1</a>
                    <a href="#" class="rounded-lg border border-zinc-300 px-3 py-1.5 hover:bg-zinc-50">2</a>
                    <a href="#" class="rounded-lg border border-zinc-300 px-3 py-1.5 hover:bg-zinc-50">Next</a>
                </nav>
                <details class="relative inline-block text-sm">
                    <summary class="cursor-pointer list-none rounded-lg border border-zinc-300 bg-white px-4 py-2 hover:bg-zinc-50">Dropdown menu</summary>
                    <div class="absolute z-10 mt-1 w-44 rounded-lg border border-zinc-200 bg-white py-1 shadow-lg">
                        <a href="#" class="block px-4 py-2 hover:bg-zinc-50">Action</a>
                        <a href="#" class="block px-4 py-2 hover:bg-zinc-50">Another</a>
                    </div>
                </details>
            </div>
        </section>

        {# 10 Modal #}
        <section id="modals" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">10) Modal</h2>
            <button type="button" id="open-demo-modal" class="rounded-lg bg-blue-600 px-4 py-2 text-sm text-white hover:bg-blue-700">Open modal</button>
            <details class="mt-4 rounded-lg border border-zinc-200 bg-zinc-50 p-4 text-sm"><summary class="cursor-pointer font-medium">Fallback: details/summary panel</summary><p class="mt-2 text-zinc-600">No JS required — native disclosure.</p></details>
            <div id="demo-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="dialog" aria-modal="true">
                <div id="demo-modal-backdrop" class="absolute inset-0 bg-zinc-900/50"></div>
                <div class="relative z-10 w-full max-w-md rounded-lg bg-white p-6 shadow-xl">
                    <h3 class="text-lg font-semibold">Modal title</h3>
                    <p class="mt-2 text-sm text-zinc-600">Minimal inline JS + backdrop.</p>
                    <div class="mt-4 flex justify-end gap-2">
                        <button type="button" id="close-demo-modal" class="rounded-lg border border-zinc-300 px-4 py-2 text-sm">Close</button>
                    </div>
                </div>
            </div>
        </section>

        {# 11 Accordion #}
        <section id="accordion" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">11) Accordion</h2>
            <div class="divide-y divide-zinc-200 rounded-lg border border-zinc-200 bg-white shadow-sm">
                <details class="group p-4" open><summary class="cursor-pointer font-medium">Section one</summary><p class="mt-2 text-sm text-zinc-600">Content for first panel.</p></details>
                <details class="group p-4"><summary class="cursor-pointer font-medium">Section two</summary><p class="mt-2 text-sm text-zinc-600">YAML-first entities.</p></details>
            </div>
        </section>

        {# 12 Progress #}
        <section id="progress" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">12) Progress & spinners</h2>
            <div class="space-y-4 rounded-lg border border-zinc-200 bg-white p-6 shadow-sm">
                <div class="h-2 w-full overflow-hidden rounded-full bg-zinc-200"><div class="h-2 w-2/3 rounded-full bg-blue-600"></div></div>
                <div class="flex gap-4">
                    <div class="h-8 w-8 animate-spin rounded-full border-4 border-zinc-200 border-t-blue-600"></div>
                    <div class="h-8 w-8 animate-pulse rounded-full bg-zinc-300"></div>
                </div>
            </div>
        </section>

        {# 13 Lists #}
        <section id="lists" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">13) Dividers & list groups</h2>
            <div class="grid gap-6 lg:grid-cols-2">
                <div><p class="text-sm">Above</p><hr class="my-2 border-zinc-200"><p class="text-sm">Below</p></div>
                <ul class="divide-y divide-zinc-200 overflow-hidden rounded-lg border border-zinc-200 bg-white text-sm shadow-sm">
                    <li class="px-4 py-3 hover:bg-zinc-50">List item one</li>
                    <li class="px-4 py-3 hover:bg-zinc-50">List item two</li>
                    <li class="px-4 py-3 hover:bg-zinc-50">List item three</li>
                </ul>
            </div>
        </section>

        {# 14 Layout #}
        <section id="layout" class="mb-16 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-zinc-900">14) Grid & flex</h2>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                {% for i in 1..4 %}<div class="rounded bg-blue-100 p-4 text-center text-sm text-blue-900">col {{ i }}</div>{% endfor %}
            </div>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-2 rounded-lg border border-zinc-200 bg-white p-4 shadow-sm">
                <span class="text-sm">Flex row</span>
                <span class="rounded bg-zinc-100 px-2 py-1 text-xs">justify-between</span>
            </div>
        </section>
