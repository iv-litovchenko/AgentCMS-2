<div class="space-y-6">
    <div id="tw-cards" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Карточки</p>
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm"><h4 class="font-semibold">Basic card</h4><p class="mt-1 text-sm text-zinc-600">Simple content block.</p></div>
            <div class="overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm">
                <div class="h-20 bg-gradient-to-r from-blue-400 to-indigo-500"></div>
                <div class="p-4"><h4 class="font-semibold">With image</h4></div>
            </div>
        </div>
    </div>

    <div id="tw-alerts" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Алерты</p>
        <div class="space-y-2">
            <div class="rounded-lg border border-green-200 bg-green-50 p-3 text-sm text-green-800">Success</div>
            <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800">Error</div>
            <div class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">Warning</div>
        </div>
    </div>

    <div id="tw-avatars" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Аватары</p>
        <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-zinc-300 text-xs font-medium">SM</span>
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-blue-600 text-sm font-medium text-white">MD</span>
        </div>
    </div>

    <div id="tw-table" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Таблица</p>
        <div class="overflow-x-auto rounded-lg border border-zinc-200 bg-white shadow-sm">
            <table class="min-w-full text-left text-sm">
                <thead class="bg-zinc-50 text-xs uppercase text-zinc-500"><tr><th class="px-4 py-2">Name</th><th class="px-4 py-2">Type</th><th class="px-4 py-2">Status</th></tr></thead>
                <tbody class="divide-y divide-zinc-100">
                    <tr><td class="px-4 py-2">main</td><td class="px-4 py-2">workspace</td><td class="px-4 py-2">active</td></tr>
                    <tr class="bg-zinc-50"><td class="px-4 py-2">sandbox</td><td class="px-4 py-2">workspace</td><td class="px-4 py-2">active</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
