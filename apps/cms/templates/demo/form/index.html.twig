{% extends 'layouts/app.html.twig' %}

{% set is_compact = compact|default(false) %}
{% if is_compact %}
    {% form_theme form 'form/themes/compact_layout.html.twig' %}
{% else %}
    {% form_theme form 'form/themes/flowbite_layout.html.twig' %}
{% endif %}

{% block title %}Demo form — Agent CMS Light{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.css" rel="stylesheet" />
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.js"></script>
{% endblock %}

{% block main %}
    <main class="mx-auto w-full max-w-2xl flex-1 {{ is_compact ? 'px-3 py-3 sm:px-4' : 'px-4 py-6 sm:px-6' }}">
        <section class="rounded-lg border border-gray-200 bg-white {{ is_compact ? 'p-3' : 'p-6' }} shadow-sm">
            <h1 class="{{ is_compact ? 'text-lg' : 'text-xl' }} font-semibold tracking-tight text-gray-900">Demo form</h1>
            <p class="mt-0.5 {{ is_compact ? 'text-xs' : 'text-sm' }} text-gray-600">
                Symfony Form + Flowbite{% if is_compact %} · <a href="{{ path('demo_form') }}" class="text-blue-600 hover:underline">обычный</a>{% else %} · <a href="{{ path('demo_form', {compact: 1}) }}" class="text-blue-600 hover:underline">compact</a>{% endif %}
            </p>

            {% for message in app.flashes('success') %}
                <div class="mt-4 p-4 text-sm text-green-800 rounded-lg bg-green-50 border border-green-200" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            {% set form_action_params = {} %}
            {% if is_compact %}
                {% set form_action_params = {compact: 1} %}
            {% endif %}
            {{ form_start(form, {action: path('demo_form', form_action_params), attr: {class: is_compact ? 'mt-3' : 'mt-6', novalidate: 'novalidate'}}) }}

            {{ form_row(form.title) }}
            {{ form_row(form.description) }}
            {{ form_row(form.contactEmail) }}
            {{ form_row(form.secret) }}
            {{ form_row(form.quantity) }}
            {{ form_row(form.category) }}
            {{ form_row(form.priority) }}
            {{ form_row(form.tags) }}
            {{ form_row(form.agreeTerms) }}
            {{ form_row(form.enableNotifications) }}
            {{ form_row(form.progressLevel) }}
            {{ form_row(form.attachment) }}
            {{ form_row(form.dueDate) }}
            {{ form_row(form.referenceCode) }}
            {{ form_row(form.disabledHint) }}
            {{ form_widget(form.token) }}

            <div class="mt-6 flex flex-wrap gap-3">
                {{ form_widget(form.save) }}
                {{ form_widget(form.reset) }}
            </div>

            {{ form_end(form, {render_rest: false}) }}
        </section>
    </main>
{% endblock %}
