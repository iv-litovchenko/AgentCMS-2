{% set is_compact = compact|default(false) %}
{% if is_compact %}
    {% form_theme form 'form/themes/compact_layout.html.twig' %}
{% else %}
    {% form_theme form 'form/themes/flowbite_layout.html.twig' %}
{% endif %}

<section class="rounded-lg border border-gray-200 bg-white {{ is_compact ? 'p-3' : 'p-6' }} shadow-sm">
    <h2 class="{{ is_compact ? 'text-lg' : 'text-xl' }} font-semibold tracking-tight text-gray-900">Symfony Form + Flowbite</h2>
    <p class="mt-0.5 {{ is_compact ? 'text-xs' : 'text-sm' }} text-gray-600">
        Демо формы{% if is_compact %} · <a href="{{ path('typography') }}" class="text-blue-600 hover:underline">обычный</a>{% else %} · <a href="{{ path('typography', {compact: 1}) }}#demo-form" class="text-blue-600 hover:underline">compact</a>{% endif %}
    </p>

    {% for message in app.flashes('success') %}
        <div class="mt-4 rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-800" role="alert">
            {{ message }}
        </div>
    {% endfor %}

    {% set form_action_params = {} %}
    {% if is_compact %}
        {% set form_action_params = {compact: 1} %}
    {% endif %}
    {{ form_start(form, {action: path('typography', form_action_params) ~ '#demo-form', attr: {class: is_compact ? 'mt-3' : 'mt-6', novalidate: 'novalidate'}}) }}

    {{ form_row(form.title) }}
    {{ form_row(form.description) }}
    {{ form_row(form.contactEmail) }}
    {{ form_row(form.secret) }}
    {{ form_row(form.quantity) }}
    {{ form_row(form.category) }}
    {{ form_row(form.priority) }}
    {{ form_row(form.tags) }}
    {{ form_row(form.agreeTerms) }}
    {{ form_row(form.enableNotifications) }}
    {{ form_row(form.progressLevel) }}
    {{ form_row(form.attachment) }}
    {{ form_row(form.dueDate) }}
    {{ form_row(form.referenceCode) }}
    {{ form_row(form.disabledHint) }}
    {{ form_widget(form.token) }}

    <div class="mt-6 flex flex-wrap gap-3">
        {{ form_widget(form.save) }}
        {{ form_widget(form.reset) }}
    </div>

    {{ form_end(form, {render_rest: false}) }}
</section>
