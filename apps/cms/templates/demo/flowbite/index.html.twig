{% extends 'layouts/app.html.twig' %}

{% block title %}Flowbite showcase — Agent CMS Light{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.css" rel="stylesheet" />
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.js"></script>
{% endblock %}

{% block main %}
    <main class="mx-auto max-w-6xl flex-1 px-4 py-8 sm:px-6">
        <header class="mb-10 border-b border-gray-200 pb-6">
            <h1 class="text-3xl font-bold text-gray-900">Flowbite showcase</h1>
            <p class="mt-2 text-sm text-gray-600">Components from <a href="https://flowbite.com/docs/getting-started/introduction/" class="text-blue-600 hover:underline">Flowbite docs</a> (CDN).</p>
        </header>

        {# 1 Buttons #}
        <section id="buttons" class="mb-14 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-gray-900">1) Buttons</h2>
            <div class="flex flex-wrap gap-2 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                <button type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5">Default</button>
                <button type="button" class="py-2.5 px-5 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100">Alternative</button>
                <button type="button" class="text-white bg-gray-800 hover:bg-gray-900 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-5 py-2.5">Dark</button>
                <button type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-lg text-sm px-5 py-2.5">Light</button>
                <button type="button" class="focus:outline-none text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:ring-green-300 font-medium rounded-lg text-sm px-5 py-2.5">Green</button>
                <button type="button" class="focus:outline-none text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5">Red</button>
                <button type="button" class="focus:outline-none text-white bg-yellow-400 hover:bg-yellow-500 focus:ring-4 focus:ring-yellow-300 font-medium rounded-lg text-sm px-5 py-2.5 text-gray-900">Yellow</button>
                <button type="button" class="focus:outline-none text-white bg-purple-700 hover:bg-purple-800 focus:ring-4 focus:ring-purple-300 font-medium rounded-lg text-sm px-5 py-2.5">Purple</button>
                <button type="button" class="text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-xs px-3 py-1.5">Small</button>
                <button type="button" class="text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-base px-6 py-3">Large</button>
                <button type="button" class="inline-flex items-center text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-5 py-2.5">
                    <svg class="w-4 h-4 me-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    Icon left
                </button>
            </div>
        </section>

        {# 2 Button group & dropdown #}
        <section id="button-groups" class="mb-14 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-gray-900">2) Button group & dropdown</h2>
            <div class="flex flex-wrap items-center gap-4 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                <div class="inline-flex rounded-md shadow-sm" role="group">
                    <button type="button" class="px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-s-lg hover:bg-gray-100">Years</button>
                    <button type="button" class="px-4 py-2 text-sm font-medium text-gray-900 bg-white border-t border-b border-gray-200 hover:bg-gray-100">Months</button>
                    <button type="button" class="px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-e-lg hover:bg-gray-100">Days</button>
                </div>
                <button id="dropdownButtonDemo" data-dropdown-toggle="dropdownDemo" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 inline-flex items-center" type="button">
                    Dropdown button
                    <svg class="w-2.5 h-2.5 ms-3" fill="none" viewBox="0 0 10 6"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/></svg>
                </button>
                <div id="dropdownDemo" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow w-44">
                    <ul class="py-2 text-sm text-gray-700" aria-labelledby="dropdownButtonDemo">
                        <li><a href="#" class="block px-4 py-2 hover:bg-gray-100">Dashboard</a></li>
                        <li><a href="#" class="block px-4 py-2 hover:bg-gray-100">Settings</a></li>
                    </ul>
                </div>
            </div>
        </section>

        {# 3 Alerts #}
        <section id="alerts" class="mb-14 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-gray-900">3) Alerts</h2>
            <div class="space-y-4">
                <div id="alert-info" class="flex items-center p-4 text-blue-800 rounded-lg bg-blue-50" role="alert">
                    <svg class="shrink-0 w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-2H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v3h1a1 1 0 0 1 0 2Z"/></svg>
                    <span class="sr-only">Info</span>
                    <div class="ms-3 text-sm font-medium">Info alert with icon.</div>
                </div>
                <div class="flex items-center p-4 text-green-800 rounded-lg bg-green-50" role="alert">
                    <svg class="shrink-0 w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z"/></svg>
                    <div class="ms-3 text-sm font-medium">Success alert.</div>
                </div>
                <div class="flex items-center p-4 text-yellow-800 rounded-lg bg-yellow-50" role="alert">
                    <div class="ms-0 text-sm font-medium">Warning alert.</div>
                </div>
                <div class="flex items-center p-4 text-red-800 rounded-lg bg-red-50" role="alert">
                    <div class="text-sm font-medium">Danger alert.</div>
                </div>
                <div id="alert-dismiss" class="flex items-center p-4 text-gray-800 rounded-lg bg-gray-50" role="alert">
                    <div class="text-sm font-medium">Dismissible alert.</div>
                    <button type="button" class="ms-auto -mx-1.5 -my-1.5 bg-gray-50 text-gray-500 rounded-lg focus:ring-2 focus:ring-gray-400 p-1.5 hover:bg-gray-200 inline-flex items-center justify-center h-8 w-8" data-dismiss-target="#alert-dismiss" aria-label="Close">
                        <span class="sr-only">Close</span>
                        <svg class="w-3 h-3" fill="none" viewBox="0 0 14 14"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/></svg>
                    </button>
                </div>
            </div>
        </section>

        {# 4 Badges #}
        <section id="badges" class="mb-14 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-gray-900">4) Badges</h2>
            <div class="flex flex-wrap gap-2 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                <span class="bg-blue-100 text-blue-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded">Default</span>
                <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-gray-300">Dark</span>
                <span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded">Red</span>
                <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded">Green</span>
                <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded">Yellow</span>
                <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">Indigo</span>
                <span class="bg-purple-100 text-purple-800 text-xs font-medium px-2.5 py-0.5 rounded">Purple</span>
                <span class="bg-blue-100 text-blue-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded-full">Pill</span>
                <span class="inline-flex items-center bg-blue-100 text-blue-800 text-xs font-medium px-2 py-0.5 rounded">
                    Removable
                    <button type="button" class="inline-flex items-center p-0.5 ms-2 text-sm text-blue-400 bg-transparent rounded-sm hover:bg-blue-200 hover:text-blue-900" aria-label="Remove">
                        <svg class="w-2 h-2" fill="none" viewBox="0 0 14 14"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/></svg>
                    </button>
                </span>
            </div>
        </section>

        {# 5 Cards #}
        <section id="cards" class="mb-14 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-gray-900">5) Cards</h2>
            <div class="grid gap-4 md:grid-cols-2">
                <div class="max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow">
                    <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900">Default card</h5>
                    <p class="mb-3 font-normal text-gray-700">Workspace metadata and YAML on disk.</p>
                    <a href="#" class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-blue-700 rounded-lg hover:bg-blue-800">Read more</a>
                </div>
                <div class="max-w-sm bg-white border border-gray-200 rounded-lg shadow">
                    <div class="h-40 rounded-t-lg bg-gradient-to-br from-cyan-500 to-blue-600"></div>
                    <div class="p-5"><h5 class="mb-2 text-xl font-bold text-gray-900">Card with image</h5><p class="text-sm text-gray-700">Media header block.</p></div>
                </div>
                <div class="flex flex-col items-center bg-white border border-gray-200 rounded-lg shadow md:flex-row md:max-w-xl">
                    <div class="flex h-32 w-full shrink-0 items-center justify-center rounded-t-lg bg-gray-200 md:w-32 md:rounded-none md:rounded-s-lg">Img</div>
                    <div class="p-4"><h5 class="mb-2 text-lg font-bold text-gray-900">Horizontal card</h5><p class="text-sm text-gray-700">Side-by-side layout.</p></div>
                </div>
                <div class="w-full max-w-sm bg-white border border-gray-200 rounded-lg shadow-sm">
                    <div class="flex flex-col items-center pb-10 pt-6">
                        <div class="mb-3 flex h-24 w-24 items-center justify-center rounded-full bg-gray-300 text-2xl font-semibold text-gray-600">AC</div>
                        <h5 class="mb-1 text-xl font-medium text-gray-900">Agent CMS</h5>
                        <span class="text-sm text-gray-500">User profile card</span>
                    </div>
                </div>
            </div>
        </section>

        {# 6 Forms #}
        <section id="forms" class="mb-14 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-gray-900">6) Forms</h2>
            <div class="grid gap-4 rounded-lg border border-gray-200 bg-white p-6 shadow-sm md:grid-cols-2">
                <div><label for="fb-text" class="block mb-2 text-sm font-medium text-gray-900">Input</label><input type="text" id="fb-text" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Name"></div>
                <div><label for="fb-search" class="block mb-2 text-sm font-medium text-gray-900">Search</label><input type="search" id="fb-search" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5" placeholder="Search"></div>
                <div class="md:col-span-2"><label for="fb-area" class="block mb-2 text-sm font-medium text-gray-900">Textarea</label><textarea id="fb-area" rows="3" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500"></textarea><p class="mt-2 text-sm text-gray-500">Helper text under field.</p></div>
                <div><label for="fb-select" class="block mb-2 text-sm font-medium text-gray-900">Select</label><select id="fb-select" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5"><option>One</option><option>Two</option></select></div>
                <div class="space-y-2"><p class="text-sm font-medium text-gray-900">Checkbox / Radio</p>
                    <div class="flex items-center"><input id="fb-chk" type="checkbox" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500"><label for="fb-chk" class="ms-2 text-sm text-gray-900">Checkbox</label></div>
                    <div class="flex items-center"><input id="fb-r1" name="fb-radio" type="radio" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 focus:ring-blue-500"><label for="fb-r1" class="ms-2 text-sm text-gray-900">Radio</label></div>
                </div>
                <div><p class="mb-2 text-sm font-medium text-gray-900">Toggle</p>
                    <label class="inline-flex items-center cursor-pointer">
                        <input type="checkbox" class="sr-only peer">
                        <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                        <span class="ms-3 text-sm text-gray-900">Enabled</span>
                    </label>
                </div>
                <div><label for="fb-range" class="block mb-2 text-sm font-medium text-gray-900">Range</label><input id="fb-range" type="range" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600"></div>
                <div class="md:col-span-2"><label for="fb-file" class="block mb-2 text-sm font-medium text-gray-900">File</label><input id="fb-file" type="file" class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 focus:outline-none file:me-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"></div>
                <div><label class="block mb-2 text-sm font-medium text-red-700">Error</label><input type="text" class="bg-red-50 border border-red-500 text-red-900 text-sm rounded-lg block w-full p-2.5"><p class="mt-2 text-sm text-red-600">Validation message.</p></div>
                <div><label class="block mb-2 text-sm font-medium text-green-700">Success</label><input type="text" value="Valid" class="bg-green-50 border border-green-500 text-green-900 text-sm rounded-lg block w-full p-2.5"></div>
            </div>
        </section>

        {# 7 Modal #}
        <section id="modals" class="mb-14 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-gray-900">7) Modal</h2>
            <button data-modal-target="flowbite-showcase-modal" data-modal-toggle="flowbite-showcase-modal" class="block text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5" type="button">Open modal</button>
            <div id="flowbite-showcase-modal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
                <div class="relative p-4 w-full max-w-md max-h-full">
                    <div class="relative bg-white rounded-lg shadow">
                        <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t border-gray-200">
                            <h3 class="text-xl font-semibold text-gray-900">Flowbite modal</h3>
                            <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center" data-modal-hide="flowbite-showcase-modal">
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 14 14"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/></svg>
                            </button>
                        </div>
                        <div class="p-4 md:p-5 space-y-4"><p class="text-base leading-relaxed text-gray-500">Modal body — data-modal-toggle from Flowbite JS.</p></div>
                        <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b">
                            <button data-modal-hide="flowbite-showcase-modal" type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# 8 Dropdown menu #}
        <section id="dropdowns" class="mb-14 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-gray-900">8) Dropdown menu</h2>
            <button id="menuDropdownButton" data-dropdown-toggle="menuDropdown" class="inline-flex items-center text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-5 py-2.5" type="button">Open menu</button>
            <div id="menuDropdown" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow w-44">
                <div class="px-4 py-3 text-sm text-gray-900"><div>Header block</div><div class="font-medium truncate">user@cms.local</div></div>
                <ul class="py-2 text-sm text-gray-700">
                    <li><a href="#" class="block px-4 py-2 hover:bg-gray-100">Profile</a></li>
                    <li><a href="#" class="block px-4 py-2 hover:bg-gray-100">Settings</a></li>
                </ul>
                <div class="py-1"><a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Sign out</a></div>
            </div>
        </section>

        {# 9 Tabs #}
        <section id="tabs" class="mb-14 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-gray-900">9) Tabs & pills</h2>
            <div class="mb-4 border-b border-gray-200">
                <ul class="flex flex-wrap -mb-px text-sm font-medium text-center text-gray-500" id="flowbite-tab" data-tabs-toggle="#flowbite-tab-content" role="tablist">
                    <li class="me-2" role="presentation"><button class="inline-block p-4 border-b-2 rounded-t-lg" id="tab-profile" data-tabs-target="#panel-profile" type="button" role="tab">Profile</button></li>
                    <li class="me-2" role="presentation"><button class="inline-block p-4 border-b-2 rounded-t-lg hover:text-gray-600 hover:border-gray-300" id="tab-dashboard" data-tabs-target="#panel-dashboard" type="button" role="tab">Dashboard</button></li>
                </ul>
            </div>
            <div id="flowbite-tab-content">
                <div class="hidden p-4 rounded-lg bg-gray-50" id="panel-profile" role="tabpanel">Profile tab panel.</div>
                <div class="hidden p-4 rounded-lg bg-gray-50" id="panel-dashboard" role="tabpanel">Dashboard tab panel.</div>
            </div>
            <div class="mt-6 flex flex-wrap gap-2 text-sm font-medium text-gray-500">
                <a href="#" class="px-4 py-2 text-white bg-blue-600 rounded-lg active" aria-current="page">Pill active</a>
                <a href="#" class="px-4 py-2 rounded-lg hover:text-gray-900 hover:bg-gray-100">Pill</a>
            </div>
        </section>

        {# 10 Navbar #}
        <section id="navbar" class="mb-14 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-gray-900">10) Navbar example</h2>
            <nav class="bg-white border-gray-200 rounded-lg border shadow-sm">
                <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
                    <a href="#" class="flex items-center space-x-3"><span class="self-center text-xl font-semibold whitespace-nowrap text-gray-900">Flowbite Nav</span></a>
                    <div class="flex md:order-2"><button type="button" class="text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-4 py-2">Action</button></div>
                    <div class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1" id="navbar-demo">
                        <ul class="flex flex-col font-medium p-4 md:p-0 mt-4 border border-gray-100 rounded-lg bg-gray-50 md:space-x-8 md:flex-row md:mt-0 md:border-0 md:bg-white">
                            <li><a href="#" class="block py-2 px-3 text-white bg-blue-700 rounded md:bg-transparent md:text-blue-700 md:p-0" aria-current="page">Home</a></li>
                            <li><a href="#" class="block py-2 px-3 text-gray-900 rounded hover:bg-gray-100 md:hover:bg-transparent md:border-0 md:hover:text-blue-700 md:p-0">About</a></li>
                        </ul>
                    </div>
                </div>
            </nav>
        </section>

        {# 11 Breadcrumb & pagination #}
        <section id="breadcrumb" class="mb-14 scroll-mt-20">
            <h2 class="mb-4 text-xl font-semibold text-gray-900">11) Breadcrumb & pagination</h2>
            <nav class="flex mb-4" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-2 rtl:space-x-reverse">
                    <li class="inline-flex items-center"><a href="#" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">Home</a></li>
                    <li><div class="flex items-center"><svg class="rtl:rotate-180 w-3 h-3 text-gray-400 mx-1" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg><a href="#" class="ms-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ms-2">CMS</a></div></li>
                    <li aria-current="page"><span class="ms-1 text-sm font-medium text-gray-500 md:ms-2">Flowbite</span></li>
                </ol>
            </nav>
            <nav aria-label="Page navigation">
                <ul class="inline-flex -space-x-px text-sm">
                    <li><a href="#" class="flex items-center justify-center px-3 h-8 ms-0 leading-tight text-gray-500 bg-white border border-e-0 border-gray-300 rounded-s-lg hover:bg-gray-100 hover:text-gray-700">Previous</a></li>
                    <li><a href="#" class="flex items-center justify-center px-3 h-8 text-blue-600 border border-gray-300 bg-blue-50 hover:bg-blue-100 hover:text-blue-700">1</a></li>
