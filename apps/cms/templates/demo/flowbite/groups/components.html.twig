<div class="space-y-6">
    <div id="fb-buttons" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Кнопки</p>
        <div class="flex flex-wrap gap-2 rounded-md border border-zinc-100 bg-zinc-50 p-4">
            <button type="button" class="rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800">Default</button>
            <button type="button" class="rounded-lg border border-gray-200 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100">Alternative</button>
            <button type="button" class="rounded-lg bg-gray-800 px-5 py-2.5 text-sm font-medium text-white hover:bg-gray-900">Dark</button>
        </div>
    </div>

    <div id="fb-dropdown" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Группа и dropdown</p>
        <div class="flex flex-wrap items-center gap-4 rounded-md border border-zinc-100 bg-zinc-50 p-4">
            <div class="inline-flex rounded-md shadow-sm" role="group">
                <button type="button" class="rounded-s-lg border border-gray-200 bg-white px-4 py-2 text-sm hover:bg-gray-100">Years</button>
                <button type="button" class="border-y border-gray-200 bg-white px-4 py-2 text-sm hover:bg-gray-100">Months</button>
                <button type="button" class="rounded-e-lg border border-gray-200 bg-white px-4 py-2 text-sm hover:bg-gray-100">Days</button>
            </div>
            <button id="dropdownButtonDemo" data-dropdown-toggle="dropdownDemo" class="inline-flex items-center rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800" type="button">
                Dropdown
                <svg class="ms-2 h-2.5 w-2.5" fill="none" viewBox="0 0 10 6"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/></svg>
            </button>
            <div id="dropdownDemo" class="z-10 hidden w-44 divide-y divide-gray-100 rounded-lg bg-white shadow">
                <ul class="py-2 text-sm text-gray-700">
                    <li><a href="#" class="block px-4 py-2 hover:bg-gray-100">Dashboard</a></li>
                    <li><a href="#" class="block px-4 py-2 hover:bg-gray-100">Settings</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div id="fb-alerts" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Алерты и бейджи</p>
        <div class="space-y-2">
            <div class="flex items-center rounded-lg bg-blue-50 p-3 text-sm text-blue-800" role="alert">Info alert</div>
            <div class="flex items-center rounded-lg bg-green-50 p-3 text-sm text-green-800" role="alert">Success alert</div>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
            <span class="rounded bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800">Default</span>
            <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800">Pill</span>
        </div>
    </div>

    <div id="fb-cards" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Карточки</p>
        <div class="grid gap-4 md:grid-cols-2">
            <div class="max-w-sm rounded-lg border border-gray-200 bg-white p-6 shadow">
                <h5 class="mb-2 text-xl font-bold text-gray-900">Default card</h5>
                <p class="text-sm text-gray-700">Workspace metadata and YAML on disk.</p>
            </div>
            <div class="max-w-sm overflow-hidden rounded-lg border border-gray-200 bg-white shadow">
                <div class="h-32 rounded-t-lg bg-gradient-to-br from-cyan-500 to-blue-600"></div>
                <div class="p-5"><h5 class="text-lg font-bold text-gray-900">With image</h5></div>
            </div>
        </div>
    </div>

    <div id="fb-forms" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Формы (Flowbite)</p>
        <div class="grid gap-4 rounded-md border border-zinc-100 bg-zinc-50 p-4 md:grid-cols-2">
            <div><label for="fb-text" class="mb-1 block text-sm font-medium text-gray-900">Input</label><input type="text" id="fb-text" class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm" placeholder="Name"></div>
            <div><label for="fb-select" class="mb-1 block text-sm font-medium text-gray-900">Select</label><select id="fb-select" class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm"><option>One</option></select></div>
        </div>
    </div>

    <div id="fb-modal" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Модальное окно</p>
        <button data-modal-target="flowbite-showcase-modal" data-modal-toggle="flowbite-showcase-modal" class="rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800" type="button">Open modal</button>
        <div id="flowbite-showcase-modal" tabindex="-1" aria-hidden="true" class="fixed left-0 right-0 top-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-y-auto overflow-x-hidden md:inset-0">
            <div class="relative max-h-full w-full max-w-md p-4">
                <div class="relative rounded-lg bg-white shadow">
                    <div class="flex items-center justify-between rounded-t border-b border-gray-200 p-4">
                        <h3 class="text-xl font-semibold text-gray-900">Flowbite modal</h3>
                        <button type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900" data-modal-hide="flowbite-showcase-modal" aria-label="Close">&times;</button>
                    </div>
                    <div class="space-y-4 p-4"><p class="text-sm text-gray-500">Modal body — data-modal-toggle from Flowbite JS.</p></div>
                    <div class="flex items-center rounded-b border-t border-gray-200 p-4">
                        <button data-modal-hide="flowbite-showcase-modal" type="button" class="rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
