<div class="space-y-6">
    <div id="fb-tabs" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Tabs</p>
        <div class="mb-3 border-b border-gray-200">
            <ul class="flex flex-wrap text-sm font-medium text-gray-500" id="flowbite-tab" data-tabs-toggle="#flowbite-tab-content" role="tablist">
                <li class="me-2" role="presentation"><button class="inline-block rounded-t-lg border-b-2 p-4" id="tab-profile" data-tabs-target="#panel-profile" type="button" role="tab">Profile</button></li>
                <li class="me-2" role="presentation"><button class="inline-block rounded-t-lg border-b-2 p-4 hover:border-gray-300 hover:text-gray-600" id="tab-dashboard" data-tabs-target="#panel-dashboard" type="button" role="tab">Dashboard</button></li>
            </ul>
        </div>
        <div id="flowbite-tab-content">
            <div class="hidden rounded-lg bg-gray-50 p-4" id="panel-profile" role="tabpanel">Profile tab panel.</div>
            <div class="hidden rounded-lg bg-gray-50 p-4" id="panel-dashboard" role="tabpanel">Dashboard tab panel.</div>
        </div>
    </div>

    <div id="fb-navbar" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Navbar</p>
        <nav class="rounded-lg border border-gray-200 bg-white shadow-sm">
            <div class="mx-auto flex max-w-screen-xl flex-wrap items-center justify-between p-4">
                <span class="text-lg font-semibold text-gray-900">Flowbite Nav</span>
                <ul class="mt-2 flex gap-4 text-sm md:mt-0">
                    <li><a href="#" class="text-blue-700">Home</a></li>
                    <li><a href="#" class="text-gray-900 hover:text-blue-700">About</a></li>
                </ul>
            </div>
        </nav>
    </div>

    <div id="fb-breadcrumb" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Breadcrumb и pagination</p>
        <nav class="mb-3 flex" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 text-sm md:space-x-2">
                <li><a href="#" class="font-medium text-gray-700 hover:text-blue-600">Home</a></li>
                <li><span class="text-gray-500">/ CMS</span></li>
            </ol>
        </nav>
        <ul class="inline-flex text-sm -space-x-px">
            <li><a href="#" class="flex h-8 items-center justify-center rounded-s-lg border border-gray-300 bg-white px-3 text-gray-500 hover:bg-gray-100">Prev</a></li>
            <li><a href="#" class="flex h-8 items-center justify-center border border-gray-300 bg-blue-50 px-3 text-blue-600">1</a></li>
            <li><a href="#" class="flex h-8 items-center justify-center rounded-e-lg border border-gray-300 bg-white px-3 text-gray-500 hover:bg-gray-100">Next</a></li>
        </ul>
    </div>

    <div id="fb-list" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Timeline, список, прогресс</p>
        <ul class="mb-4 w-full rounded-lg border border-gray-200 bg-white text-sm font-medium text-gray-900">
            <li class="w-full border-b border-gray-200 px-4 py-2">List group item</li>
            <li class="w-full px-4 py-2">Second item</li>
        </ul>
        <div class="w-full max-w-md rounded-md border border-zinc-100 bg-zinc-50 p-4">
            <div class="mb-1 text-sm font-medium text-gray-700">Progress</div>
            <div class="h-2.5 w-full rounded-full bg-gray-200"><div class="h-2.5 rounded-full bg-blue-600" style="width: 45%"></div></div>
        </div>
    </div>

    <div id="fb-toast" class="scroll-mt-24">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Toast</p>
        <div id="toast-static" class="flex max-w-xs items-center rounded-lg border border-gray-200 bg-white p-4 text-sm text-gray-500 shadow" role="alert">
            <div class="me-3 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-green-100 text-green-500">OK</div>
            <div class="text-sm font-normal">Static toast notification.</div>
        </div>
    </div>
</div>
