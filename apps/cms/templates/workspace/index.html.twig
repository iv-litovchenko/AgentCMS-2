{% extends 'layouts/app.html.twig' %}

{% block title %}Хранилища — {{ cms_site_title }}{% endblock %}

{% block main %}
    <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-4 px-4 py-6 sm:px-6">
        {% for message in app.flashes('success') %}
            <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="alert">
                {{ message }}
            </div>
        {% endfor %}

        {% include 'workspace/_storages_section.html.twig' with {storages: storages, is_compact: false} %}
    </div>
{% endblock %}
