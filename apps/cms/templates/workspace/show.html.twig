{% extends 'layouts/app.html.twig' %}

{% block title %}{{ workspace.name }} — Agent CMS Light{% endblock %}

{% block main %}
    <main class="mx-auto w-full max-w-2xl flex-1 px-4 py-6 sm:px-6">
        <div class="mb-4">
            <a href="{{ path('workspace_index') }}" class="text-sm text-blue-600 hover:underline">← К списку хранилищ</a>
        </div>

        <article class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm">
            <div class="flex items-start gap-4">
                {% include 'workspace/_avatar.html.twig' with {
                    avatar: workspace.avatar,
                    initials: workspace.initials,
                    size: 'h-14 w-14'
                } %}
                <div class="min-w-0 flex-1">
                    <h1 class="text-xl font-semibold tracking-tight text-zinc-900">{{ workspace.name }}</h1>
                    <p class="mt-1 text-xs text-zinc-500">/{{ workspace.slug }}</p>
                </div>
            </div>

            <dl class="mt-6 space-y-4 text-sm">
                <div>
                    <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500">Папка</dt>
                    <dd class="mt-1 font-mono text-zinc-900">{{ workspace.folder }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500">Размещение</dt>
                    <dd class="mt-1 text-zinc-900">
                        {% if workspace.location == 'server' %}Сервер{% else %}Локально{% endif %}
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500">Порядок сортировки</dt>
                    <dd class="mt-1 text-zinc-900">{{ workspace.sort_order }}</dd>
                </div>
                {% if workspace.description %}
                    <div>
                        <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500">Описание</dt>
                        <dd class="mt-1 whitespace-pre-wrap text-zinc-700">{{ workspace.description }}</dd>
                    </div>
                {% endif %}
                <div class="grid gap-4 border-t border-zinc-100 pt-4 sm:grid-cols-2">
                    <div>
                        <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500">Создано</dt>
                        <dd class="mt-1 text-zinc-700">{{ workspace.created_at }}</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500">Обновлено</dt>
                        <dd class="mt-1 text-zinc-700">{{ workspace.updated_at }}</dd>
                    </div>
                </div>
            </dl>

            <p class="mt-6 rounded-md border border-dashed border-zinc-200 bg-zinc-50 px-3 py-2 text-xs text-zinc-500">
                Заготовка страницы workspace — позже здесь будут записи, файлы и настройки хранилища.
            </p>

            <div class="mt-4">
                <a href="{{ path('workspace_edit', {id: workspace.id}) }}"
                   class="text-sm text-blue-600 hover:underline">Редактировать</a>
            </div>
        </article>
    </main>
{% endblock %}
