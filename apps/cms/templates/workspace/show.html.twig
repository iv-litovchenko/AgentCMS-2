{% extends 'layouts/app.html.twig' %}

{% block title %}{{ workspace.name }} — Agent CMS Light{% endblock %}

{% block main %}
    <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-4 px-4 py-6 sm:px-6 lg:flex-row lg:items-start">
        <aside class="w-full shrink-0 lg:w-52" aria-label="Хранилище">
            <div class="rounded-lg border border-zinc-200 bg-white p-3 shadow-sm">
                <div class="mb-3 flex items-center gap-2 border-b border-zinc-100 pb-3">
                    {% include 'workspace/_avatar.html.twig' with {
                        avatar: workspace.avatar,
                        initials: workspace.initials,
                        size: 'h-9 w-9'
                    } %}
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-semibold text-zinc-900">{{ workspace.name }}</p>
                        <p class="truncate text-xs text-zinc-500">/{{ workspace.slug }}</p>
                    </div>
                </div>
                <ul class="mb-3 space-y-0.5 border-b border-zinc-100 pb-3 text-sm">
                    <li>
                        <span class="flex items-center gap-2 rounded-md bg-zinc-100 px-2.5 py-1.5 font-medium text-zinc-900">
                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                            Обзор
                        </span>
                    </li>
                    <li>
                        <span class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-zinc-400">Поиск</span>
                    </li>
                    <li>
                        <span class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-zinc-400">Журнал</span>
                    </li>
                </ul>

                {% include 'workspace/_entry_tree_stub.html.twig' %}
                <div class="mt-3 border-t border-zinc-100 pt-3 text-xs">
                    <a href="{{ path('home') }}" class="text-blue-600 hover:underline">← Главная</a>
                    <span class="mx-1 text-zinc-300">·</span>
                    <a href="{{ path('workspace_index') }}" class="text-blue-600 hover:underline">Все хранилища</a>
                </div>
            </div>
        </aside>

        <div class="flex min-w-0 flex-1 flex-col gap-4">
            <header class="rounded-lg border border-zinc-200 bg-white px-4 py-4 shadow-sm">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <h1 class="text-xl font-semibold tracking-tight text-zinc-900">{{ workspace.name }}</h1>
                        {% if workspace.description %}
                            <p class="mt-2 max-w-2xl text-sm text-zinc-600">{{ workspace.description }}</p>
                        {% endif %}
                    </div>
                    <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-medium {% if workspace.location == 'server' %}bg-blue-50 text-blue-700{% else %}bg-emerald-50 text-emerald-700{% endif %}">
                        {% if workspace.location == 'server' %}сервер{% else %}локально{% endif %}
                    </span>
                </div>
                <p class="mt-3 font-mono text-xs text-zinc-500">{{ workspace.folder }}</p>
            </header>

            <section class="rounded-lg border border-dashed border-zinc-200 bg-zinc-50 px-4 py-8 text-center text-sm text-zinc-500 shadow-sm">
                Контент хранилища (записи, файлы) — следующий этап. Сейчас открыт workspace по адресу
                <code class="rounded bg-white px-1 text-xs text-zinc-700">{{ path('workspace_show', {slug: workspace.slug}) }}</code>.
            </section>

            <p class="text-sm">
                <a href="{{ path('workspace_edit', {id: workspace.id}) }}" class="text-blue-600 hover:underline">Настройки хранилища</a>
            </p>
        </div>
    </div>
{% endblock %}
