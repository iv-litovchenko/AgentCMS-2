<section class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
        <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Docker · монтирования</h2>
            {% include 'home/_section_todo_badge.html.twig' %}
        </div>
        <p class="text-xs text-zinc-500">
            {{ starter_mounts_config_path }} · override <span class="font-mono">{{ starter_mounts_override_path }}</span>
            · платформа <span class="font-mono">{{ starter_mount_platform }}</span>
        </p>
    </div>

    <p class="mb-3 text-xs text-zinc-600">
        Дополнительные папки хоста в контейнер cms (bind mount). Dev-монтирования кода — в
        <span class="font-mono">docker-compose.override.example.yml</span>. По умолчанию одна пустая точка; пресеты и «Добавить» — ещё.
    </p>

    <div class="mb-3 flex flex-wrap gap-2">
        {% for preset in starter_mount_presets %}
            {% if preset.id not in starter_mount_ids %}
                <form method="post" action="{{ path('starter_mount_add_preset') }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('starter_mount') }}">
                    <input type="hidden" name="preset_id" value="{{ preset.id }}">
                    <button type="submit" class="rounded-md border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs font-medium text-zinc-800 hover:bg-white">
                        + {{ preset.label }}
                    </button>
                </form>
            {% endif %}
        {% endfor %}
        <form method="post" action="{{ path('starter_mount_add') }}" class="inline">
            <input type="hidden" name="_token" value="{{ csrf_token('starter_mount') }}">
            <button type="submit" class="rounded-md border border-dashed border-zinc-300 px-2.5 py-1 text-xs font-medium text-zinc-600 hover:border-zinc-400 hover:bg-zinc-50">
                + Точка монтирования
            </button>
        </form>
    </div>

    <form id="starter-mounts-form" method="post" action="{{ path('starter_mount_save') }}" class="hidden">
        <input type="hidden" name="_token" value="{{ csrf_token('starter_mount') }}">
    </form>

    <div class="space-y-3">
        <div class="overflow-x-auto rounded-md border border-zinc-100 bg-zinc-50">
            <table class="min-w-full text-left text-xs">
                <thead class="border-b border-zinc-200 text-zinc-500">
                    <tr>
                        <th class="px-2 py-1.5 font-medium">Название</th>
                        <th class="px-2 py-1.5 font-medium">Путь на хосте</th>
                        <th class="px-2 py-1.5 font-medium">В контейнере</th>
                        <th class="px-2 py-1.5 font-medium">ro</th>
                        <th class="px-2 py-1.5 font-medium"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100 bg-white">
                    {% for mount in starter_mounts %}
                        <tr class="align-middle">
                            <td class="px-2 py-1.5">
                                <input form="starter-mounts-form" type="text" name="mount[{{ mount.id }}][label]" value="{{ mount.label }}"
                                       class="w-full min-w-[6rem] rounded border border-zinc-200 px-2 py-1 text-zinc-900">
                            </td>
                            <td class="px-2 py-1.5">
                                <input form="starter-mounts-form" type="text" name="mount[{{ mount.id }}][host_path]" value="{{ mount.host_path }}"
                                       placeholder="/Users/…"
                                       class="w-full min-w-[10rem] rounded border border-zinc-200 px-2 py-1 font-mono text-zinc-900">
                            </td>
                            <td class="px-2 py-1.5">
                                <input form="starter-mounts-form" type="text" name="mount[{{ mount.id }}][container_path]" value="{{ mount.container_path }}"
                                       class="w-full min-w-[10rem] rounded border border-zinc-200 px-2 py-1 font-mono text-zinc-900">
                            </td>
                            <td class="px-2 py-1.5 text-center">
                                <input form="starter-mounts-form" type="checkbox" name="mount[{{ mount.id }}][read_only]" value="1" {% if mount.read_only %}checked{% endif %}
                                       class="rounded border-zinc-300 text-zinc-900">
                            </td>
                            <td class="px-2 py-1.5">
                                <form method="post" action="{{ path('starter_mount_remove', {id: mount.id}) }}" class="inline"
                                      onsubmit="return confirm('Удалить точку?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('starter_mount') }}">
                                    <button type="submit" class="text-zinc-500 hover:text-red-600" title="Удалить">×</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <button form="starter-mounts-form" type="submit" class="rounded-md bg-zinc-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-zinc-800">
            Сохранить и обновить override
        </button>
    </div>

    <div class="mt-4">
        <p class="mb-1 text-xs font-medium uppercase tracking-wide text-zinc-500">Фрагмент compose</p>
        <pre class="max-h-40 overflow-auto rounded-md border border-zinc-100 bg-zinc-900 p-3 text-xs leading-relaxed text-zinc-100">{{ starter_mounts_override_yaml }}</pre>
    </div>
</section>
