{% extends 'app/layout.html.twig' %}

{% block title %}{{ app.label }} — {{ cms_site_title }}{% endblock %}

{% block app_content %}
    {% include 'app/_page_plashka.html.twig' with {
        plashka_label: app.label,
        plashka_aria_label: app.label,
    } %}

    <div class="space-y-4">
        {% for message in starter_flashes.success|default([]) %}
            <p class="rounded-lg border border-green-200 bg-green-50 px-4 py-2 text-sm text-green-800">{{ message }}</p>
        {% endfor %}
        {% for message in starter_flashes.error|default([]) %}
            <p class="rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-800">{{ message }}</p>
        {% endfor %}

        <section class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-zinc-500">Docker</h2>
            <dl class="divide-y divide-zinc-100 text-sm">
                <div class="grid gap-1 py-2.5 sm:grid-cols-[11rem_1fr] sm:gap-4">
                    <dt class="text-zinc-500">Среда</dt>
                    <dd class="font-medium text-zinc-900">{{ environment.docker.runtime }}</dd>
                </div>
                <div class="grid gap-1 py-2.5 sm:grid-cols-[11rem_1fr] sm:gap-4">
                    <dt class="text-zinc-500">Стек</dt>
                    <dd class="text-zinc-900">{{ environment.docker.stack }}</dd>
                </div>
            </dl>
        </section>

        <section class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-zinc-500">ОС и платформа</h2>
            <dl class="divide-y divide-zinc-100 text-sm">
                <div class="grid gap-1 py-2.5 sm:grid-cols-[11rem_1fr] sm:gap-4">
                    <dt class="text-zinc-500">Хост</dt>
                    <dd class="font-medium text-zinc-900">{{ environment.platform.host }}</dd>
                </div>
                <div class="grid gap-1 py-2.5 sm:grid-cols-[11rem_1fr] sm:gap-4">
                    <dt class="text-zinc-500">ОС PHP</dt>
                    <dd class="text-zinc-900">{{ environment.platform.container_os }} · {{ environment.platform.php_os_family }}</dd>
                </div>
                <div class="grid gap-1 py-2.5 sm:grid-cols-[11rem_1fr] sm:gap-4">
                    <dt class="text-zinc-500">Архитектура</dt>
                    <dd class="text-zinc-900">{{ environment.platform.machine }}</dd>
                </div>
            </dl>
        </section>

        <section class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-zinc-500">Диск</h2>
            <dl class="grid gap-3 sm:grid-cols-2">
                <div class="rounded-md border border-zinc-100 bg-zinc-50 px-4 py-3">
                    <dt class="text-xs text-zinc-500">Всего</dt>
                    <dd class="mt-1 text-lg font-semibold tabular-nums text-zinc-900">{{ environment.disk.total }}</dd>
                </div>
                <div class="rounded-md border border-zinc-100 bg-zinc-50 px-4 py-3">
                    <dt class="text-xs text-zinc-500">Свободно</dt>
                    <dd class="mt-1 text-lg font-semibold tabular-nums text-zinc-900">{{ environment.disk.free }}</dd>
                </div>
            </dl>
        </section>

        <section class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-zinc-500">Технологии</h2>
            <dl class="divide-y divide-zinc-100 rounded-md border border-zinc-100 text-sm">
                {% for tech in environment.technologies %}
                    <div class="grid gap-1 px-3 py-2.5 sm:grid-cols-[12rem_1fr] sm:items-center sm:gap-4">
                        <dt class="font-medium text-zinc-900">{{ tech.name }}</dt>
                        <dd class="truncate text-zinc-600 sm:text-right">{{ tech.version }}</dd>
                    </div>
                {% endfor %}
            </dl>
        </section>

        <section class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Пакеты</h2>
            {% if starter_packages is empty %}
                <p class="text-sm text-zinc-500">Пусто</p>
            {% else %}
                <ul>
                    {% for pkg in starter_packages %}
                        {% include 'app/starter/_toggle_row.html.twig' with { item: pkg, kind: 'package' } %}
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Отдельные сервисы</h2>
            <p class="mb-3 text-xs text-zinc-500">Контейнеры на поддоменах — вкл/выкл и пункт «Сервисы» в шапке.</p>
            {% if starter_services is empty %}
                <p class="text-sm text-zinc-500">Пусто</p>
            {% else %}
                <ul>
                    {% for svc in starter_services %}
                        {% include 'app/starter/_toggle_row.html.twig' with { item: svc, kind: 'service' } %}
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Внутренние сервисы</h2>
            <p class="mb-3 text-xs text-zinc-500">CLI и утилиты в образе CMS — реестр <span class="font-mono">cli_tools.yaml</span>.</p>
            {% if environment.internal_services is empty %}
                <p class="text-sm text-zinc-500">Пусто</p>
            {% else %}
                <ul class="divide-y divide-zinc-100 rounded-md border border-zinc-100">
                    {% for svc in environment.internal_services %}
                        <li class="px-3 py-2.5 text-sm">
                            <p class="font-medium text-zinc-900">{{ svc.name }}</p>
                            {% if svc.description %}
                                <p class="mt-0.5 text-xs text-zinc-500">{{ svc.description }}</p>
                            {% endif %}
                            <p class="mt-1 truncate font-mono text-xs text-zinc-600">{{ svc.version }}</p>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {% include 'app/starter/_env_groups.html.twig' %}

        {% include 'app/starter/_mounts_section.html.twig' %}

        <section class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Журнал</h2>
            {% if starter_log_journal.lines is empty %}
                <p class="text-sm text-zinc-500">Записей пока нет · <span class="font-mono text-xs">var/log/*.log</span></p>
            {% else %}
                <div class="max-h-64 overflow-auto rounded-md border border-zinc-100 bg-zinc-50">
                    <pre class="p-3 text-xs leading-relaxed text-zinc-800 whitespace-pre-wrap break-all">{% for entry in starter_log_journal.lines %}<span class="text-zinc-400">{{ entry.source }} </span>{{ entry.text }}
{% endfor %}</pre>
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include 'app/starter/_toggle_script.html.twig' %}
{% endblock %}
