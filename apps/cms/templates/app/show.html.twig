{% extends 'app/layout.html.twig' %}

{% block title %}{{ app.label }} — Agent CMS Light{% endblock %}

{% block app_content %}
    <article class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-zinc-500">Приложение</p>
        <h1 class="mt-1 text-xl font-semibold tracking-tight text-zinc-900">{{ app.label }}</h1>
        <p class="mt-2 font-mono text-xs text-zinc-500">/app/{{ app.name }}</p>
        <p class="mt-4 text-sm text-zinc-600">
            Заготовка экрана приложения. Конфигурация — в
            <code class="rounded bg-zinc-100 px-1 text-xs">resources/cms/ui/menu.yaml</code>, секция
            <code class="rounded bg-zinc-100 px-1 text-xs">apps</code>.
        </p>
    </article>
{% endblock %}
