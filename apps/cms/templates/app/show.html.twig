{% extends 'app/layout.html.twig' %}

{% block title %}{{ app.label }} — Agent CMS Light{% endblock %}

{% block app_content %}
    {% include 'app/_page_plashka.html.twig' with {
        plashka_label: app.label,
        plashka_aria_label: app.label,
    } %}

    <article class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
        <p class="font-mono text-xs text-zinc-500">/app/{{ app.name }}</p>
        <p class="mt-3 text-sm text-zinc-600">
            Заготовка экрана приложения. Конфигурация — в
            <code class="rounded bg-zinc-100 px-1 text-xs">resources/cms/ui/menu.yaml</code>, секция
            <code class="rounded bg-zinc-100 px-1 text-xs">apps</code>.
        </p>
    </article>
{% endblock %}
