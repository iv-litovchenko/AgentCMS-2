{% extends 'app/layout.html.twig' %}

{% block title %}{{ app.label }} — {{ cms_site_title }}{% endblock %}

{% block app_content %}
    {% include 'app/_page_plashka.html.twig' with {
        plashka_label: app.label,
        plashka_aria_label: app.label,
    } %}

    {% for message in connector_flashes.success|default([]) %}
        <p class="mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-2 text-sm text-green-800">{{ message }}</p>
    {% endfor %}
    {% for message in connector_flashes.error|default([]) %}
        <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-800">{{ message }}</p>
    {% endfor %}

    <div class="space-y-4">
        <section class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <div class="mb-3 flex flex-wrap items-center gap-2">
                <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Подключение MCP</h2>
                {% include 'home/_section_todo_badge.html.twig' %}
            </div>
            <p class="mb-4 text-sm text-zinc-600">
                Канонический адрес MCP — <span class="font-medium">HTTPS</span>
                (<span class="font-mono">PUBLIC_BASE_DOMAIN</span>, <span class="font-mono">PUBLIC_HTTPS_PORT</span>).
            </p>

            <dl class="divide-y divide-zinc-100 text-sm">
                <div class="grid gap-1 py-2.5 sm:grid-cols-[10rem_1fr] sm:gap-4">
                    <dt class="text-zinc-500">CMS</dt>
                    <dd class="font-mono text-xs text-zinc-900">{{ connector_connection.cms_url }}</dd>
                </div>
                <div class="grid gap-1 py-2.5 sm:grid-cols-[10rem_1fr] sm:gap-4">
                    <dt class="text-zinc-500">MCP endpoint</dt>
                    <dd class="font-mono text-xs text-zinc-900">{{ connector_connection.mcp_url }}</dd>
                </div>
            </dl>

            <p class="mt-4 text-xs font-medium uppercase tracking-wide text-zinc-500">Пример mcp.json</p>
            <p class="mt-1 text-xs text-zinc-500">
                Заголовок <span class="font-mono">Authorization</span> — из токена «Agent CMS MCP» ниже (<span class="font-mono">mcp_auth_token_id</span> в реестре).
            </p>
            {% if not connector_connection.mcp_auth_configured %}
                <p class="mt-2 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900">
                    Токен MCP не задан: в JSON стоит заглушка <span class="font-mono">Bearer &lt;не задан&gt;</span>. Укажите значение в блоке «MCP · токены» и сохраните — затем обновите страницу для готового фрагмента.
                </p>
            {% endif %}
            <pre class="mt-2 max-h-48 overflow-auto rounded-md border border-zinc-100 bg-zinc-900 p-3 text-xs leading-relaxed text-zinc-100">{{ connector_connection.mcp_json_example }}</pre>
        </section>

        {% include 'app/connector/_tokens_form.html.twig' %}
    </div>
{% endblock %}
