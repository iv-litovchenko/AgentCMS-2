<nav class="mb-4 rounded-lg border border-zinc-200 bg-white px-2 py-2 shadow-sm" aria-label="Приложения">
    <div class="flex flex-wrap items-center gap-2 px-1">
        <span class="shrink-0 text-xs font-medium uppercase tracking-wide text-zinc-500">Приложения</span>
        <span class="hidden h-4 w-px bg-zinc-200 sm:inline" aria-hidden="true"></span>
        <ul class="flex min-w-0 flex-1 flex-wrap gap-1 text-sm">
            {% for nav in ui_menu_apps %}
                <li>
                    <a href="{{ nav.url }}"
                       class="rounded-md px-2.5 py-1.5 {% if nav.active %}bg-zinc-900 font-medium text-white{% else %}text-zinc-600 hover:bg-zinc-100{% endif %}">
