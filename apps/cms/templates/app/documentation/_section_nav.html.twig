{% if doc_sections is defined and (doc_app is defined or app is defined) %}
    {% set nav_app = doc_app|default(app) %}
    <nav class="mb-4 rounded-lg border border-zinc-200 bg-white px-2 py-2 shadow-sm" aria-label="Документация">
        <div class="flex flex-wrap items-center gap-2 px-1">
            <span class="shrink-0 text-xs font-medium uppercase tracking-wide text-zinc-500">{{ nav_app.label }}</span>
            {% if doc_sections is not empty %}
                <span class="hidden h-4 w-px bg-zinc-200 sm:inline" aria-hidden="true"></span>
                <ul class="flex flex-wrap gap-1 text-sm">
                    {% for nav in doc_sections %}
                        <li>
                            <a href="{{ nav.url }}"
                               class="rounded-md px-2.5 py-1.5 {% if nav.active %}bg-zinc-900 font-medium text-white{% else %}text-zinc-600 hover:bg-zinc-100{% endif %}">
                                {{ nav.label }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </nav>
{% endif %}
