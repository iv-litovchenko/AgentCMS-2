{% extends 'app/documentation/layout.html.twig' %}

{% block title %}{{ section.label }} — {{ app.label }}{% endblock %}

{% block doc_content %}
    <section class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
        <h2 class="text-lg font-semibold tracking-tight text-zinc-900">{{ section.label }}</h2>
        {% if readme_empty %}
            <p class="mt-3 text-sm text-zinc-500">
                Файл <code class="rounded bg-zinc-100 px-1 text-xs">{{ readme_path_label }}</code> в корне репозитория пока пуст.
            </p>
        {% else %}
            <div class="mt-4 max-w-none overflow-x-auto rounded-md border border-zinc-100 bg-zinc-50 p-4 text-sm leading-relaxed text-zinc-800 whitespace-pre-wrap">{{ readme_body }}</div>
        {% endif %}
    </section>
{% endblock %}
