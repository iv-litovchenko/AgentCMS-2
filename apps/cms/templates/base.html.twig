<!DOCTYPE html>
<html lang="ru" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ cms_site_title }}{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['system-ui', 'Segoe UI', 'Roboto', 'sans-serif'],
                    },
                },
            },
        };
    </script>
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% endblock %}
</head>
<body class="min-h-full flex flex-col bg-zinc-50 text-zinc-900 antialiased">
{% block body %}{% endblock %}
</body>
</html>
