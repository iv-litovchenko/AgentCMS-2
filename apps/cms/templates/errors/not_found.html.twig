{% extends 'layouts/app.html.twig' %}

{% block title %}404 — не найдено{% endblock %}

{% block main %}
<section class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-4 py-12 sm:px-6">
    <article class="mx-auto w-full max-w-lg rounded-lg border border-zinc-200 bg-white p-6 text-center shadow-sm sm:p-8">
        <p class="text-5xl font-bold tabular-nums text-zinc-300">404</p>
        <h1 class="mt-3 text-xl font-semibold tracking-tight text-zinc-900">Не найдено</h1>
        <p class="mt-2 text-sm leading-relaxed text-zinc-600">
            {{ message|default('Страница не найдена.') }}
        </p>
        <a href="{{ path('home') }}"
           class="mt-6 inline-flex items-center rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-800">
            На главную
        </a>
    </article>
</section>
{% endblock %}
