<div class="flex flex-col gap-4 lg:flex-row lg:items-start">
    {% include 'typography/_sidebar_nav.html.twig' %}

    <div class="min-w-0 flex-1 space-y-10">
        <header class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="text-lg font-semibold tracking-tight text-zinc-900">Заготовки интерфейса</h2>
            <p class="mt-2 text-sm text-zinc-600">
                Справа — живые примеры: utility-классы Tailwind (CDN), Symfony Form с темой полей и компоненты Flowbite.
                Выберите раздел слева или прокрутите список.
            </p>
        </header>

        <div class="space-y-4">
            {% include 'typography/_section_card.html.twig' with {
                section_id: 'compact',
                section_title: 'Плотность (compact)',
                section_lead: 'Сравнение отступов с обычным режимом и главной.',
                section_template: 'typography/blocks/compact.html.twig',
            } %}
        </div>

        <div class="space-y-4">
            {% include 'typography/_section_card.html.twig' with {
                section_id: 'demo-form',
                section_title: 'Symfony Form + Flowbite',
                section_lead: 'Тема полей из form/themes, отправка на этот же раздел.',
                section_template: 'typography/blocks/symfony_form.html.twig',
            } %}
        </div>

        <div class="space-y-4">
            <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Tailwind (CDN)</h2>
            {% include 'typography/_section_card.html.twig' with {
                section_id: 'tw-text',
                section_title: 'Текст и код',
                section_lead: 'Заголовки, абзацы, цитаты, inline и block code.',
                section_template: 'demo/tailwind/groups/text.html.twig',
            } %}
            {% include 'typography/_section_card.html.twig' with {
                section_id: 'tw-ui',
                section_title: 'Элементы управления',
                section_lead: 'Кнопки, поля, чекбоксы, бейджи.',
                section_template: 'demo/tailwind/groups/controls.html.twig',
            } %}
            {% include 'typography/_section_card.html.twig' with {
                section_id: 'tw-surfaces',
                section_title: 'Поверхности и данные',
                section_lead: 'Карточки, алерты, аватары, таблицы.',
                section_template: 'demo/tailwind/groups/surfaces.html.twig',
            } %}
            {% include 'typography/_section_card.html.twig' with {
                section_id: 'tw-patterns',
                section_title: 'Паттерны',
                section_lead: 'Табы, модалка (inline JS), аккордеон, прогресс, сетка.',
                section_template: 'demo/tailwind/groups/patterns.html.twig',
            } %}
        </div>

        <div class="space-y-4">
            <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Flowbite (CDN)</h2>
            {% include 'typography/_section_card.html.twig' with {
                section_id: 'fb-ui',
                section_title: 'Компоненты',
                section_lead: 'Кнопки, dropdown, алерты, карточки, формы, модалка (Flowbite JS).',
                section_template: 'demo/flowbite/groups/components.html.twig',
            } %}
            {% include 'typography/_section_card.html.twig' with {
                section_id: 'fb-chrome',
                section_title: 'Навигация и обратная связь',
                section_lead: 'Tabs, navbar, breadcrumb, pagination, списки, toast.',
                section_template: 'demo/flowbite/groups/chrome.html.twig',
            } %}
        </div>
    </div>
</div>
