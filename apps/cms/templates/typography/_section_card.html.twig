<section id="{{ section_id }}" class="scroll-mt-20 rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
    {% if section_title|default('') != '' %}
        <h3 class="text-sm font-semibold tracking-tight text-zinc-900">{{ section_title }}</h3>
    {% endif %}
    {% if section_lead|default('') != '' %}
        <p class="mt-1 text-sm text-zinc-600">{{ section_lead }}</p>
    {% endif %}
    <div class="{% if section_title|default('') != '' or section_lead|default('') != '' %}mt-4{% endif %}">
        {% include section_template %}
    </div>
</section>
