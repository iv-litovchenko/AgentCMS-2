{% extends 'app/documentation/layout.html.twig' %}

{% set is_compact = compact|default(false) %}
{% set page_title = section.label|default('Типография') %}

{% block title %}{{ page_title }} — Документация{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.css" rel="stylesheet" />
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.js"></script>
    <script>
        (function () {
            var modal = document.getElementById('demo-modal');
            var openBtn = document.getElementById('open-demo-modal');
            var closeBtn = document.getElementById('close-demo-modal');
            var backdrop = document.getElementById('demo-modal-backdrop');
            if (!modal || !openBtn) {
                return;
            }
            function openModal() {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
            function closeModal() {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
            openBtn.addEventListener('click', openModal);
            if (closeBtn) {
                closeBtn.addEventListener('click', closeModal);
            }
            if (backdrop) {
                backdrop.addEventListener('click', closeModal);
            }
        })();
    </script>
{% endblock %}

{% block doc_content %}
    <article class="space-y-6">
        <header class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="text-lg font-semibold tracking-tight text-zinc-900">{{ page_title }}</h2>
            <p class="mt-2 max-w-3xl text-sm text-zinc-600">
                UI-kit на одной странице: плотный режим, Symfony Form, Tailwind и Flowbite.
            </p>
            <div class="mt-4 flex flex-wrap items-center gap-2">
                <nav class="flex flex-wrap gap-1.5 text-xs" aria-label="Подразделы типографии">
                    <a href="#compact" class="rounded-full bg-zinc-100 px-2.5 py-1 text-zinc-700 hover:bg-zinc-200">Compact</a>
                    <a href="#demo-form" class="rounded-full bg-zinc-100 px-2.5 py-1 text-zinc-700 hover:bg-zinc-200">Форма</a>
                    <a href="#tailwind" class="rounded-full bg-zinc-100 px-2.5 py-1 text-zinc-700 hover:bg-zinc-200">Tailwind</a>
                    <a href="#flowbite" class="rounded-full bg-zinc-100 px-2.5 py-1 text-zinc-700 hover:bg-zinc-200">Flowbite</a>
                </nav>
                <span class="hidden h-4 w-px bg-zinc-200 sm:inline" aria-hidden="true"></span>
                {% if is_compact %}
                    <a href="{{ path('app_section', {name: 'documentation', section: 'typography'}) }}"
                       class="text-xs text-blue-600 hover:underline">Обычный режим</a>
                {% else %}
                    <a href="{{ path('app_section', {name: 'documentation', section: 'typography', compact: 1}) }}"
                       class="text-xs text-blue-600 hover:underline">Compact-режим страницы</a>
                {% endif %}
            </div>
        </header>

        <section id="compact" class="scroll-mt-28 rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="text-lg font-semibold text-zinc-900">Compact</h2>
            <p class="mt-1 text-sm text-zinc-600">Сравнение отступов и размеров текста.</p>
            <div class="mt-4 grid gap-4 lg:grid-cols-2">
                <div class="rounded-lg border border-zinc-100 bg-zinc-50 p-4">
                    <p class="text-xs font-medium uppercase tracking-wide text-zinc-500">Обычный</p>
                    <h3 class="mt-2 text-xl font-semibold text-zinc-900">Заголовок секции</h3>
                    <p class="mt-2 text-sm leading-relaxed text-zinc-600">Стандартные отступы и размер шрифта.</p>
                </div>
                <div class="rounded-lg border border-zinc-100 bg-zinc-50 p-3">
                    <p class="text-xs font-medium uppercase tracking-wide text-zinc-500">Compact</p>
                    <h3 class="mt-1 text-lg font-semibold text-zinc-900">Заголовок секции</h3>
                    <p class="mt-1 text-xs leading-snug text-zinc-600">Меньше отступов — как на главной в compact.</p>
                </div>
            </div>
            <p class="mt-3 text-sm">
                <a href="{{ path('home_compact') }}" class="text-blue-600 hover:underline">Главная в compact</a>
            </p>
        </section>

        <section id="demo-form" class="scroll-mt-28">
            <h2 class="mb-3 text-lg font-semibold text-zinc-900">Форма (Symfony + Flowbite)</h2>
            <div class="max-w-2xl">
                {% include 'demo/form/_embed.html.twig' with {show_heading: false} %}
            </div>
        </section>

        <section id="tailwind" class="scroll-mt-28 rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="text-lg font-semibold text-zinc-900">Tailwind</h2>
            <p class="mt-1 mb-4 text-sm text-zinc-600">Utility-first паттерны (CDN Tailwind).</p>
            {% include 'demo/tailwind/_showcase.html.twig' %}
        </section>

        <section id="flowbite" class="scroll-mt-28 rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="text-lg font-semibold text-zinc-900">Flowbite</h2>
            <p class="mt-1 mb-4 text-sm text-zinc-600">Компоненты Flowbite (CDN).</p>
            {% include 'demo/flowbite/_showcase.html.twig' %}
        </section>
    </article>
{% endblock %}
