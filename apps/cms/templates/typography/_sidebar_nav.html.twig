{% set typo_route = typography_route_name|default('app_show') %}
{% set typo_params = typography_route_params|default({name: 'typography'}) %}
<aside class="lg:sticky lg:top-4 lg:max-h-[calc(100vh-2rem)] lg:w-60 lg:shrink-0 lg:overflow-y-auto" aria-label="Навигация по заготовкам">
    <nav class="space-y-4 rounded-lg border border-zinc-200 bg-white p-3 shadow-sm sm:p-4">
        <div>
            <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">CMS</p>
            <ul class="space-y-1 rounded-md border border-zinc-100 bg-zinc-50 p-2 text-sm">
                <li><a href="#compact" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Плотность (compact)</a></li>
                <li><a href="#demo-form" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Symfony Form</a></li>
            </ul>
        </div>

        <div>
            <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Tailwind (CDN)</p>
            <ul class="space-y-1 rounded-md border border-zinc-100 bg-zinc-50 p-2 text-sm">
                <li><a href="#tw-typography" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Типографика</a></li>
                <li><a href="#tw-buttons" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Кнопки</a></li>
                <li><a href="#tw-fields" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Поля (Tailwind)</a></li>
                <li><a href="#tw-badges" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Бейджи</a></li>
                <li><a href="#tw-cards" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Карточки</a></li>
                <li><a href="#tw-alerts" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Алерты</a></li>
                <li><a href="#tw-avatars" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Аватары</a></li>
                <li><a href="#tw-table" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Таблица</a></li>
                <li><a href="#tw-nav" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Навигация</a></li>
                <li><a href="#tw-modal" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Модальное окно</a></li>
                <li><a href="#tw-accordion" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Аккордеон и прогресс</a></li>
                <li><a href="#tw-grid" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Сетка</a></li>
            </ul>
        </div>

        <div>
            <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Flowbite (CDN)</p>
            <ul class="space-y-1 rounded-md border border-zinc-100 bg-zinc-50 p-2 text-sm">
                <li><a href="#fb-buttons" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Кнопки</a></li>
                <li><a href="#fb-dropdown" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Группа и dropdown</a></li>
                <li><a href="#fb-alerts" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Алерты и бейджи</a></li>
                <li><a href="#fb-cards" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Карточки</a></li>
                <li><a href="#fb-forms" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Формы (Flowbite)</a></li>
                <li><a href="#fb-modal" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Модальное окно</a></li>
                <li><a href="#fb-tabs" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Tabs</a></li>
                <li><a href="#fb-navbar" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Navbar</a></li>
                <li><a href="#fb-breadcrumb" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Breadcrumb и pagination</a></li>
                <li><a href="#fb-list" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Timeline, список, прогресс</a></li>
                <li><a href="#fb-toast" class="block rounded px-2 py-1 text-zinc-700 hover:bg-white hover:text-blue-600">Toast</a></li>
            </ul>
        </div>

        <div class="border-t border-zinc-100 pt-3 text-xs text-zinc-600">
            {% if is_compact|default(false) %}
                <a href="{{ path(typo_route, typo_params) }}" class="text-blue-600 hover:underline">Обычный вид</a>
            {% else %}
                <a href="{{ path(typo_route, typo_params|merge({compact: 1})) }}" class="text-blue-600 hover:underline">Режим Compact</a>
            {% endif %}
        </div>
    </nav>
</aside>
