{% set is_compact = is_compact|default(false) %}
{% set record_cells = record_cells|default([
    {initials: 'ЗА', label: 'Заметка'},
    {initials: 'ТЗ', label: 'Тема'},
    {initials: 'ЧК', label: 'Чеклист'},
    {initials: 'ДО', label: 'Док'},
    {initials: 'ИД', label: 'Идея'},
    {initials: 'СС', label: 'Ссылка'},
    {initials: 'МД', label: 'Media'},
    {initials: 'КР', label: 'Кратко'},
    {initials: 'ПЛ', label: 'План'},
    {initials: 'АР', label: 'Архив'},
    {initials: 'ЧТ', label: 'Черновик'},
    {initials: 'ВХ', label: 'Входящее'},
]) %}
{% set grid_cols = is_compact ? 4 : 6 %}
<section class="w-full rounded-lg border border-zinc-200 bg-white shadow-sm" aria-labelledby="records-grid-heading">
    <div class="border-b border-zinc-100 {{ is_compact ? 'px-3 py-2' : 'px-4 py-3' }}">
        <div class="flex flex-wrap items-center gap-2">
            <h2 id="records-grid-heading" class="{{ is_compact ? 'text-xs' : 'text-sm' }} font-semibold text-zinc-900">Записи</h2>
            {% include 'home/_section_todo_badge.html.twig' %}
        </div>
        <p class="mt-0.5 text-xs text-zinc-500">Сетка записей — заготовка под выборку из хранилищ.</p>
    </div>
    <div class="grid grid-cols-4 gap-px border-b border-zinc-100 bg-zinc-200 sm:grid-cols-6">
        {% for cell in record_cells %}
            {% set col = loop.index0 % grid_cols %}
            {% set row = (loop.index0 / grid_cols)|round(0, 'floor') %}
            {% set is_alt = ((row + col) % 2) == 0 %}
            <div class="flex flex-col items-center justify-center gap-1.5 px-2 py-4 {{ is_alt ? 'bg-zinc-50' : 'bg-white' }} {{ is_compact ? 'py-3' : 'py-5' }}">
                <span class="{{ is_compact ? 'h-8 w-8 text-[10px]' : 'h-9 w-9 text-xs' }} flex shrink-0 items-center justify-center rounded-md bg-zinc-100 font-medium text-zinc-600 ring-1 ring-zinc-200/80">
                    {{ cell.initials }}
                </span>
                <span class="max-w-full truncate text-center text-[11px] text-zinc-600">{{ cell.label }}</span>
            </div>
        {% endfor %}
    </div>
</section>
