{% set is_compact = is_compact|default(false) %}
{% set feed_items = feed_items|default([
    {text: 'Обновлена запись «API v1»', storage: 'Основной workspace', time: '12 мин назад'},
    {text: 'Новый файл в теме «Черновики»', storage: 'Песочница', time: '1 ч назад'},
    {text: 'Переименован slug workspace', storage: 'Архив 2025', time: 'вчера'},
    {text: 'Индекс поиска пересобран', storage: 'Основной workspace', time: 'вчера'},
    {text: 'Добавлена ссылка в журнал', storage: 'Песочница', time: '2 дня назад'},
]) %}
<section class="w-full rounded-lg border border-zinc-200 bg-white shadow-sm" aria-labelledby="activity-feed-heading">
    <div class="border-b border-zinc-100 {{ is_compact ? 'px-3 py-2' : 'px-4 py-3' }}">
        <div class="flex flex-wrap items-center gap-2">
            <h2 id="activity-feed-heading" class="{{ is_compact ? 'text-xs' : 'text-sm' }} font-semibold text-zinc-900">Лента потока</h2>
            {% include 'home/_section_todo_badge.html.twig' %}
        </div>
        <p class="mt-0.5 text-xs text-zinc-500">Последние изменения в хранилищах — заготовка.</p>
    </div>
    <ul class="divide-y divide-zinc-100">
        {% for item in feed_items %}
            <li class="px-4 py-3 {{ is_compact ? 'px-3 py-2' : '' }}">
                <p class="text-sm text-zinc-800">{{ item.text }}</p>
                <p class="mt-1 text-xs text-zinc-500">
                    <span class="text-zinc-600">{{ item.storage }}</span>
                    <span class="text-zinc-300" aria-hidden="true"> · </span>
                    <span>{{ item.time }}</span>
                </p>
            </li>
        {% endfor %}
    </ul>
</section>
