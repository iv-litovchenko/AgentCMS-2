{% extends 'layouts/app.html.twig' %}

{% block title %}{{ cms_site_title }}{% endblock %}

{% block main %}
    {% set is_compact = compact|default(false) %}

    {% if is_compact %}
        <p class="mx-auto max-w-6xl px-4 pt-3 text-xs text-zinc-500 sm:px-6">Компактный режим · <a href="{{ path('home') }}" class="text-blue-600 hover:underline">обычный вид</a></p>
    {% endif %}

    <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col {{ is_compact ? 'gap-2 px-3 py-3 sm:px-4' : 'gap-4 px-4 py-6 sm:px-6' }}">
        {% if demo_block is not null %}
            {% include '@DemoBlock/block.html.twig' %}
        {% endif %}

        {% include 'workspace/_storages_section.html.twig' with {storages: storages, is_compact: is_compact} %}

        {% include 'home/_records_grid_stub.html.twig' with {is_compact: is_compact} %}
        {% include 'home/_in_focus_stub.html.twig' with {is_compact: is_compact} %}
        {% include 'home/_activity_feed_stub.html.twig' with {is_compact: is_compact} %}
    </div>
{% endblock %}
